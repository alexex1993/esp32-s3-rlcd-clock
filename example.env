# Образец файла .env. Скопируйте его и заполните то, что нужно именно вам:
#
#     cp example.env .env
#
# Сам .env в репозиторий не попадает (он в .gitignore), а этот файл — попадает,
# поэтому реальные пароли и токены здесь писать нельзя.
#
# Все строки необязательные. Пустое значение — то же самое, что отсутствующая
# строка: то, что от неё зависит, просто не попадёт в прошивку, а экран
# напишет, чего ему не хватает. Значения можно брать в кавычки.
#
# scripts/env_flags.py превращает это в макросы -D при сборке, поэтому
# ПОСЛЕ ЛЮБОЙ ПРАВКИ ЭТОГО ФАЙЛА ПРОШИВКУ НУЖНО ПЕРЕСОБРАТЬ И ЗАЛИТЬ ЗАНОВО.
# Какие экраны вообще попадут в прошивку — это не здесь, а раздел [modes]
# в platformio.ini.

# --- Wi-Fi ------------------------------------------------------------------
# Без этих двух строк прошивка вообще не выходит в сеть: ни NTP, ни погоды, ни
# новостей, ни пейджера, ни экрана ПК. Время тогда выставляется из консоли
# командой T2026-09-09 21:30:00. Сеть должна быть 2,4 ГГц.
# Например: SSID=home-wifi
SSID=
PWD=

# --- Новости (экран «В МИРЕ») -----------------------------------------------
# Бесплатный ключ NewsAPI: https://newsapi.org/register — 100 запросов в сутки,
# а один запрос здесь равен одному открытию экрана.
# Например: NEWS_API=0123456789abcdef0123456789abcdef
NEWS_API=

# --- Telegram-пейджер --------------------------------------------------------
# Токен бота от @BotFather. Пейджер ходит в Telegram только через SOCKS5-прокси
# и прямого пути не имеет, так что без SOCKS5_HOST экрана тоже не будет.
# Например: TOKEN_BOT=123456789:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw
TOKEN_BOT=

# Адрес прокси. Порт по умолчанию 1080.
# Например: SOCKS5_HOST=proxy.example.net
SOCKS5_HOST=
SOCKS5_PORT=

# Логин и пароль к прокси (RFC 1929). Если логин пуст, авторизация не
# предлагается вовсе — для прокси без пароля обе строки оставьте пустыми.
SOCKS5_USER=
SOCKS5_PASSWORD=

# --- Игровой ПК (экран «КОМПЬЮТЕР») -----------------------------------------
# Адрес компьютера, на котором запущен rtss_api (см. rtss_api/README_RTSS.md), в вашей
# локальной сети. Порт по умолчанию 8099 — как у самого rtss_api.
# Можно писать и вместе с портом (192.168.0.100:8099), и целиком скопировать
# адрес из браузера (http://192.168.0.100:8099/); отдельный RTSS_PORT главнее.
# Например: RTSS_HOST=192.168.0.100
RTSS_HOST=
RTSS_PORT=
